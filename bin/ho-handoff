#!/bin/bash

handoff="${XDG_DATA_HOME:-$HOME/.local/share}/ho-handoff.md"
if [ ! -f "$handoff" ]; then
  echo "handoff not found: $handoff" >&2
  exit 1
fi

IFS= read -r cwd < "$handoff"
if [[ "$cwd" != "cwd: "* ]]; then
  echo "invalid handoff cwd: $cwd" >&2
  exit 1
fi
cwd="${cwd#cwd: }"
if [ ! -d "$cwd" ]; then
  echo "handoff cwd not found: $cwd" >&2
  exit 1
fi

prompt="$(sed '1,2d' "$handoff")"
if [ -z "$prompt" ]; then
  echo "handoff prompt is empty: $handoff" >&2
  exit 1
fi

(cd "$cwd" && OPENCODE_PERMISSION='{"*":"allow"}' opencode --prompt "$prompt")
